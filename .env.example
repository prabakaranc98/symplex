# Loaded server-side from .env. Never served to the browser.
OPENAI_API_KEY=
OPENAI_HEAVY_MODEL=gpt-6-astra
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_VALIDATOR_MODEL=gpt-5.6-sol
# First workspace creation freezes this global cap. Reopening never resets it.
SYMPLEX_MAX_USD=5

# Optional role-specific overrides. Investigation depth otherwise chooses heavy effort.
# OPENAI_HEAVY_REASONING_EFFORT=medium
# OPENAI_VALIDATOR_REASONING_EFFORT=low
